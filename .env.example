# Copie este arquivo para .env e preencha com suas credenciais locais
# O arquivo .env NUNCA deve ser commitado (está no .gitignore)

# PostgreSQL - connection string
# Formato: postgresql://usuario:senha@host/banco?sslmode=disable
DATABASE_URL=postgresql://usuario:senha@host/nome_banco?sslmode=disable

# Opcional
PORT=5050

# GitHub Token - necessário para sincronização de commits no módulo Updates
# Crie um token em: https://github.com/settings/tokens
# Permissões necessárias: repo (read), security_events (read), dependabot_secrets (read)
# ATENÇÃO: Token Obrigatório para o módulo Git Analytics funcionar em produção
GITHUB_TOKEN=ghp_your_github_token_here
