# Copie este arquivo para .env e preencha com suas credenciais locais
# O arquivo .env NUNCA deve ser commitado (está no .gitignore)

# PostgreSQL - connection string
# Formato: postgresql://usuario:senha@host/banco?sslmode=disable
DATABASE_URL=postgresql://usuario:senha@host/nome_banco?sslmode=disable

# Opcional
PORT=5050
