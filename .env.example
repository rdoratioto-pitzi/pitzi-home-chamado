# Copie este arquivo para .env e preencha com suas credenciais locais
# O arquivo .env NUNCA deve ser commitado (está no .gitignore)

# PostgreSQL - connection string
# Formato: postgresql://usuario:senha@host/banco?sslmode=disable
# Usada pelo Express dev local apenas (Supabase/Postgres local).
DATABASE_URL=postgresql://usuario:senha@host/nome_banco?sslmode=disable

# ─────────────────────────────────────────────────────────────────
# Aplicação de SQL nos bancos Neon (dev/prod)
# ─────────────────────────────────────────────────────────────────
# Para aplicar mudanças de schema fora do drizzle-kit (ALTERs ad-hoc,
# migrations manuais), use:
#   npm run db:apply:dev "ALTER TABLE foo ADD COLUMN bar text;"
#   npm run db:apply:dev -- -f migrations/20260502-mentions.sql
#   npm run db:apply:prod ...     (exige confirmação textual)
#
# Connection strings ficam no Bitwarden vault (não em .env), nos itens:
#   - neon-dev-database-url
#   - neon-prod-database-url
# Pré-requisitos: `bw unlock` + `export BW_SESSION=...` antes de rodar.

# Opcional
PORT=5050

# URL base da aplicação (frontend). Usada para montar links nas notificações Slack.
# Local: http://localhost:5050  ·  Dev: https://home-dev.renovsmart.com.br  ·  Prod: https://home.renovsmart.com.br
# Quando o host contém "home-dev" ou "localhost", as mensagens Slack recebem o prefixo "[DEV]".
APP_URL=http://localhost:5050

# RenovSmart API Token — usado para proxy endpoints /avaliacoes-ia/* e /estoques
# Token de autenticação na API dash.renovsmart.com.br
RENOVSMART_API_TOKEN=your_renovsmart_api_token_here

# GitHub Token - necessário para sincronização de commits no módulo Updates
# Crie um token em: https://github.com/settings/tokens
# Permissões necessárias: repo (read), security_events (read), dependabot_secrets (read)
# ATENÇÃO: Token Obrigatório para o módulo Git Analytics funcionar em produção
# Também usado para autenticação do gh CLI
GITHUB_TOKEN=ghp_your_github_token_here

# ─────────────────────────────────────────────────────────────────
# MCP Servers (Model Context Protocol)
# Servidores MCP ampliam as capacidades do Claude Code
# Documentação completa em: docs/MCPs/README.md
# ─────────────────────────────────────────────────────────────────

# Brave Search MCP — Busca web com privacidade
# Cadastro gratuito (2.000 req/mês) em: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# Firecrawl MCP — Web scraping avançado com JavaScript rendering
# Cadastro em: https://www.firecrawl.dev/ (plano gratuito disponível)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Supabase MCP — Dashboard e management via HTTP
# Formato: https://mcp.supabase.com/mcp?project_ref=SEU_PROJECT_REF
SUPABASE_MCP_URL=https://mcp.supabase.com/mcp?project_ref=your_project_ref

# Venus API Key — acesso externo para consulta de chamados pelo Venus
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VENUS_API_KEY=

# ─────────────────────────────────────────────────────────────────
# Slack Integration (Fase 1 — outbound only para canal #devs-renov)
# Documentação completa: docs/integrations/SLACK-SETUP.md
# ─────────────────────────────────────────────────────────────────

# Bot User OAuth Token da Slack App. Inicia com xoxb-…
# Obter em: https://api.slack.com/apps → seu app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Signing Secret (reservado para Fase 2 — eventos inbound, slash commands)
# Obter em: Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Channel ID do #devs-renov (NÃO o nome — começa com C…)
# Obter clicando no nome do canal no Slack → ver detalhes → copiar Channel ID
SLACK_CHANNEL_DEVS=C0XXXXXXX

# Feature flag global: defina como "false" para desligar todas as
# notificações Slack sem precisar remover o token (rollback rápido).
SLACK_INTEGRATION_ENABLED=true
